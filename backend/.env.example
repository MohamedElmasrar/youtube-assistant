# --- API keys -----------------------------------------------------------------
# Required for the agent (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Optional: video metadata (YouTube Data API v3). Transcripts and chat work without it.
YOUTUBE_API_KEY=

# --- LangSmith tracing (optional) ----------------------------------------------
# Leave LANGSMITH_TRACING=false to disable. To trace runs, add a key from
# https://smith.langchain.com/settings and set LANGSMITH_TRACING=true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=youtube-assistant
# EU region only:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Models --------------------------------------------------------------------
# Fast, inexpensive tool-calling model. "-latest" aliases avoid pinning a deprecated model.
GEMINI_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: Hugging Face token for faster, rate-limit-free embedding model downloads.
HF_TOKEN=

# --- Storage (paths are relative to backend/) ---------------------------------
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=video_transcripts
TRANSCRIPT_CACHE_DIR=./data/transcripts

# --- Retrieval and chunking ----------------------------------------------------
TOP_K=5
# all-MiniLM-L6-v2 truncates at 256 word pieces; larger chunks are partly unsearchable.
CHUNK_TOKENS=240
CHUNK_OVERLAP_TOKENS=40

# --- Agent limits (per run) ----------------------------------------------------
MAX_TOOL_CALLS=6
MAX_MODEL_CALLS=8

# --- Server --------------------------------------------------------------------
# The agent reaches the MCP server mounted on the same Agent Server through this URL.
LANGGRAPH_API_URL=http://localhost:2024
# Timeout for YouTube Data API requests, in seconds.
HTTP_TIMEOUT_SECONDS=10
